{
  "name": "context-prism-dsh-plugin",
  "version": "0.8.0",
  "private": true,
  "description": "DSH plugin with an in-process JavaScript port of ContextPrism (Local Context Engine)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LFM097384/Context-Prism.git"
  },
  "homepage": "https://github.com/LFM097384/Context-Prism",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react"
      ],
      "immediately": true
    }
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/engine.test.js test/plugin.test.js test/compat.test.js test/engine_fixes.test.js test/host.test.js",
    "test:compat": "node --test test/compat.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
